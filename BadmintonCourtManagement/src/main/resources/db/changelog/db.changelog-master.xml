    </changeSet>
    <changeSet id="025" author="thach">
        <!-- Legacy databases already ran these statements under the old
             rbac-jwt.sql lineage: either refresh_token exists, or the player
             password column this file reads from has already been dropped.
             Either signal marks the database as migrated, so 025 is recorded
             as ran without re-executing. Fresh databases still run it. -->
        <preConditions onFail="MARK_RAN">
            <and>
                <not>
                    <tableExists tableName="refresh_token"/>
                </not>
                <columnExists tableName="player" columnName="password"/>
            </and>
        </preConditions>
        <sqlFile path="db/changelog/rbac-jwt.sql"/>
    </changeSet>
    <changeSet id="026" author="devin">
        <validCheckSum>1:any</validCheckSum>
        <sqlFile path="db/changelog/billing-tables.sql"/>
    </changeSet>
    <changeSet id="027" author="devin">
        <validCheckSum>1:any</validCheckSum>
        <!-- On machines where the backup feature was set up before this
             changeset was recorded (backup_deletion_log already exists),
             re-running the file would fail on duplicate table, columns or
             triggers. Skip it there; fresh databases still run it. -->
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="backup_deletion_log"/>
            </not>
        </preConditions>
        <sqlFile path="db/changelog/backup-change-tracking.sql"/>
    </changeSet>

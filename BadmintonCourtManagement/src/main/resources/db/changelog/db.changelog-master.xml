<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="001" author="thach">
        <!-- FROZEN changeset: the file was rewritten after early databases
             executed it, so each era recorded a different checksum. 1:any
             accepts whatever a machine stored, which makes this deploy
             work on any legacy database. From 029 onward checksums are
             validated strictly again. -->
        <validCheckSum>1:any</validCheckSum>
        <sqlFile path="db/changelog/badminton-qa.sql"/>
    </changeSet>
    <changeSet id="002" author="thach">
        <validCheckSum>1:any</validCheckSum>
        <sqlFile path="db/changelog/root-user.sql"/>
    </changeSet>
